{
  "_version": "1.86.0",
  "sap.app": {
    "id": "project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "0c1aaf5c-70dc-44e8-8e13-5f5bc10a00a9"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/player-crm/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PlayersList",
          "target": "PlayersList"
        },
        {
          "pattern": "Players({key}):?query:",
          "name": "PlayersObjectPage",
          "target": "PlayersObjectPage"
        },
        {
          "pattern": "MarketingCampaigns:?query:",
          "name": "MarketingCampaignsList",
          "target": "MarketingCampaignsList"
        },
        {
          "pattern": "MarketingCampaigns({key}):?query:",
          "name": "MarketingCampaignsObjectPage",
          "target": "MarketingCampaignsObjectPage"
        },
        {
          "pattern": "OrderIssues:?query:",
          "name": "OrderIssuesList",
          "target": "OrderIssuesList"
        },
        {
          "pattern": "OrderIssues({key}):?query:",
          "name": "OrderIssuesObjectPage",
          "target": "OrderIssuesObjectPage"
        }
      ],
      "targets": {
        "PlayersList": {
          "type": "Component",
          "id": "PlayersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Players",
              "variantManagement": "Control",
              "views": {
                "paths": [
                  {
                    "key": "all",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AllPlayers"
                  },
                  {
                    "key": "atRisk",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AtRiskPlayers"
                  },
                  {
                    "key": "vip",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#VipPlayers"
                  }
                ]
              },
              "navigation": {
                "Players": {
                  "detail": {
                    "route": "PlayersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "openCampaigns": {
                      "press": "project1.ext.controller.Navigation.toCampaigns",
                      "text": "{i18n>navToCampaigns}",
                      "enabled": true,
                      "visible": true,
                      "position": {
                        "placement": "After",
                        "anchor": "Create"
                      }
                    },
                    "openIssues": {
                      "press": "project1.ext.controller.Navigation.toIssues",
                      "text": "{i18n>navToIssues}",
                      "enabled": true,
                      "visible": true,
                      "position": {
                        "placement": "After",
                        "anchor": "openCampaigns"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "PlayersObjectPage": {
          "type": "Component",
          "id": "PlayersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Players",
              "sectionLayout": "Tabs"
            }
          }
        },
        "MarketingCampaignsList": {
          "type": "Component",
          "id": "MarketingCampaignsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MarketingCampaigns",
              "variantManagement": "Page",
              "navigation": {
                "MarketingCampaigns": {
                  "detail": {
                    "route": "MarketingCampaignsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "openPlayers": {
                      "press": "project1.ext.controller.Navigation.toPlayers",
                      "text": "{i18n>navToPlayers}",
                      "enabled": true,
                      "visible": true,
                      "position": {
                        "placement": "After",
                        "anchor": "Create"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "MarketingCampaignsObjectPage": {
          "type": "Component",
          "id": "MarketingCampaignsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/MarketingCampaigns"
            }
          }
        },
        "OrderIssuesList": {
          "type": "Component",
          "id": "OrderIssuesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/OrderIssues",
              "variantManagement": "Page",
              "navigation": {
                "OrderIssues": {
                  "detail": {
                    "route": "OrderIssuesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable" },
                  "actions": {
                    "openPlayers": {
                      "press": "project1.ext.controller.Navigation.toPlayers",
                      "text": "{i18n>navToPlayers}",
                      "enabled": true,
                      "visible": true
                    }
                  }
                }
              }
            }
          }
        },
        "OrderIssuesObjectPage": {
          "type": "Component",
          "id": "OrderIssuesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/OrderIssues"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
