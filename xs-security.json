{
  "xsappname": "player-crm",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.CRMAdmin",
      "description": "Full access to the CRM: players, statuses, loyalty and campaigns"
    },
    {
      "name": "$XSAPPNAME.SupportAgent",
      "description": "Player support: interactions and feedback"
    },
    {
      "name": "$XSAPPNAME.CommunityManager",
      "description": "Marketing campaigns and player analytics"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "CRMAdmin",
      "description": "CRM Administrator",
      "scope-references": [
        "$XSAPPNAME.CRMAdmin"
      ],
      "attribute-references": []
    },
    {
      "name": "SupportAgent",
      "description": "Support Agent",
      "scope-references": [
        "$XSAPPNAME.SupportAgent"
      ],
      "attribute-references": []
    },
    {
      "name": "CommunityManager",
      "description": "Community Manager",
      "scope-references": [
        "$XSAPPNAME.CommunityManager"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "PlayerCRM_Admin",
      "description": "Player CRM administrator",
      "role-template-references": [
        "$XSAPPNAME.CRMAdmin"
      ]
    },
    {
      "name": "PlayerCRM_Support",
      "description": "Player CRM support agent",
      "role-template-references": [
        "$XSAPPNAME.SupportAgent"
      ]
    },
    {
      "name": "PlayerCRM_Community",
      "description": "Player CRM community manager",
      "role-template-references": [
        "$XSAPPNAME.CommunityManager"
      ]
    }
  ]
}
